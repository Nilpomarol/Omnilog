org.gradle.jvmargs=-Xmx6144m -XX:MaxMetaspaceSize=1024m -Dfile.encoding=UTF-8
org.gradle.parallel=true
org.gradle.workers.max=2
kotlin.daemon.jvmargs=-Xmx4096m
android.useAndroidX=true
android.disallowKotlinSourceSets=false

# Optional provider credentials.
# Copy this file to the untracked root gradle.properties, set the values in
# ~/.gradle/gradle.properties, or provide matching environment variables.
# Never commit real credentials.
GOOGLE_BOOKS_API_KEY=
RAWG_API_KEY=
OMDB_API_KEY=
MAL_CLIENT_ID=
TMDB_API_KEY=
